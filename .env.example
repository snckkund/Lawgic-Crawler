# ─── LAWGIC Environment Configuration ───
# Copy this file to .env and fill in your values.

# ─── LLM Provider ───
# Options: groq | gemini | openrouter | ollama
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_MODEL=gemma4:31b-cloud
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ─── Fallback Providers (comma-separated) ───
# LLM_FALLBACK_PROVIDERS=gemini,openrouter

# ─── Provider-Specific API Keys (for fallback) ───
# GROQ_API_KEY=your_groq_key
# GEMINI_API_KEY=your_gemini_key
# OPENROUTER_API_KEY=your_openrouter_key

# ─── Embedding Model ───
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Database ───
DATABASE_PATH=lawgic.db

# ─── Web Crawling ───
CRAWL_ENABLED=true
CRAWL_RATE_LIMIT=1.0
CRAWL_MAX_RESULTS=10
CRAWL_TIMEOUT=15

# ─── Caching ───
CACHE_ENABLED=true
CACHE_LLM_TTL=3600
CACHE_CRAWL_TTL=86400

# ─── OCR ───
# Set to your tesseract binary path (e.g., /usr/bin/tesseract or /opt/homebrew/bin/tesseract)
TESSERACT_CMD=tesseract

# ─── Flask ───
FLASK_HOST=0.0.0.0
FLASK_PORT=5050
FLASK_DEBUG=true
SECRET_KEY=lawgic-secret-key-change-in-production
